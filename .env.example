PRICER_QWEN_MODEL=qwen3.6:latest
# Select the provider for host-run processes: ollama (default), vllm, or gateway.
PRICER_LLM_PROVIDER=ollama
OLLAMA_API_BASE=http://localhost:11434
# Used when PRICER_LLM_PROVIDER=vllm.
VLLM_API_BASE=http://host.docker.internal:8001/v1
# Optional override for either provider.
# PRICER_LLM_API_BASE=http://host.docker.internal:8001/v1
# LiteLLM gateway settings (used by docker compose; replace the master key).
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-secret
LITELLM_SALT_KEY=sk-replace-with-a-stable-random-secret
LITELLM_DB_PASSWORD=replace-with-a-long-random-hex-password
# Optional app virtual key. If unset, Compose uses the master key (local development only).
# PRICER_LLM_API_KEY=sk-generated-virtual-key
PRICER_GATEWAY_UPSTREAM_MODEL=ollama_chat/qwen3.6:latest
PRICER_GATEWAY_UPSTREAM_API_BASE=http://host.docker.internal:11434
# Set this if the upstream vLLM server requires an API key.
PRICER_GATEWAY_UPSTREAM_API_KEY=not-required
PRICER_API_KEY=replace-with-a-long-random-value
PRICER_APPROVAL_CONFIDENCE=0.85
PRICER_ALERT_DIR=artifacts
PRICER_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PRICER_OPEN_BROWSER=true

# Asset/state root defaults to the checkout root, or ~/.pricer for an installed wheel.
# PRICER_HOME=/var/lib/pricer
# Relative overrides resolve beneath PRICER_HOME.
# PRICER_VECTORSTORE_PATH=products_vectorstore
# PRICER_MEMORY_PATH=memory.json
# PRICER_INTELLIGENCE_PATH=artifacts/pricer_intelligence.sqlite3
# PRICER_CHECKPOINT_PATH=artifacts/deep_neural_network.pth
